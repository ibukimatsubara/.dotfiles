#!/bin/bash

colors_file="${CONFIG_DIR:-$HOME/.config/sketchybar}/colors.sh"
if [ -r "$colors_file" ]; then
    # shellcheck source=/dev/null
    . "$colors_file"
else
    FOCUS_COLOR=0xffbfc5e8
    MAUVE_COLOR=0xffe2bbd8
    BORDER_COLOR=0x6646464d
fi

active_start="${FOCUS_COLOR:-0xffbfc5e8}"
active_end="${MAUVE_COLOR:-$active_start}"
inactive_border="${BORDER_COLOR:-0x6646464d}"

options=(
    style=round
    width=3.0
    active_color="gradient(top_left=${active_start},bottom_right=${active_end})"
    inactive_color="$inactive_border"
)

borders "${options[@]}"
