{
  "google_token_command": ["gcloud", "auth", "print-access-token"],
  "services": [
    {
      "id": "langdict",
      "name": "LangDict",
      "reporting_timezone": "Asia/Tokyo",
      "monthly_price_usd": "4.99",
      "analytics": {
        "source": "bigquery",
        "project_id": "YOUR_FIREBASE_PROJECT",
        "dataset_id": "analytics_YOUR_GA4_PROPERTY_ID",
        "location": "US",
        "maximum_bytes_billed": 10485760
      },
      "revenuecat": {
        "project_id": "",
        "api_key_env": "REVENUECAT_API_KEY",
        "api_key_file": "~/.config/mibuki-metrics/revenuecat-key"
      }
    }
  ]
}
