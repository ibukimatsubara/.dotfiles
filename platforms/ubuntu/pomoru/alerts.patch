+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn manual_sessions_advance_and_wait_on_the_final_second() {
+        for (mode, break_count, next_mode, next_count, next_seconds) in [
+            (SessionMode::Work, 0, SessionMode::ShortBreak, 1, 600),
+            (SessionMode::Work, 1, SessionMode::ShortBreak, 2, 600),
+            (SessionMode::Work, 2, SessionMode::LongBreak, 3, 1800),
+            (SessionMode::ShortBreak, 1, SessionMode::Work, 1, 3000),
+            (SessionMode::LongBreak, 3, SessionMode::Work, 3, 3000),
+        ] {
+            let mut app = Pomo::new();
+            app.work_time = Duration::from_secs(3000);
+            app.short_break_time = Duration::from_secs(600);
+            app.long_break_time = Duration::from_secs(1800);
+            app.mode = mode;
+            app.break_count = break_count;
+            app.auto_switch_sessions = false;
+            app.is_running = true;
+            app.time_remaining = Duration::from_secs(1);
+            assert_eq!(app.tick(), Some(AlertEvent::Complete(mode)));
+            assert!(!app.is_running, "the next session must wait for Space");
+            assert_eq!(app.mode, next_mode);
+            assert_eq!(app.break_count, next_count);
+            assert_eq!(app.time_remaining, Duration::from_secs(next_seconds));
+            assert_eq!(app.total_duration, Duration::from_secs(next_seconds));
+            assert_eq!(app.tick(), None);
+            assert_eq!(app.time_remaining, Duration::from_secs(next_seconds));
+        }
+    }
+
+    #[test]
+    fn paused_timer_never_advances() {
+        let mut app = Pomo::new();
+        app.time_remaining = Duration::from_secs(61);
+        for _ in 0..3 {
+            app.tick();
+        }
+        assert_eq!(app.time_remaining, Duration::from_secs(61));
+    }
+
+    #[test]
+    fn all_session_types_warn_once_and_complete_once_across_pause_resume() {
+        for (mode, next_mode) in [
+            (SessionMode::Work, SessionMode::ShortBreak),
+            (SessionMode::ShortBreak, SessionMode::Work),
+            (SessionMode::LongBreak, SessionMode::Work),
+        ] {
+            let mut app = Pomo::new();
+            app.mode = mode;
+            app.auto_switch_sessions = false;
+            app.time_remaining = Duration::from_secs(62);
+            app.is_running = true;
+            assert_eq!(app.tick(), None); // 61 seconds
+            app.is_running = false;
+            assert_eq!(app.tick(), None);
+            app.is_running = true;
+            assert_eq!(app.tick(), Some(AlertEvent::Warning)); // 60 seconds
+            app.is_running = false;
+            assert_eq!(app.tick(), None);
+            app.is_running = true;
+            for _ in 0..59 {
+                assert_eq!(app.tick(), None);
+            }
+            assert_eq!(app.tick(), Some(AlertEvent::Complete(mode)));
+            assert!(!app.is_running);
+            assert_eq!(app.mode, next_mode);
+            assert_eq!(app.tick(), None);
+        }
+    }
+
+    #[test]
+    fn short_sessions_do_not_emit_a_late_one_minute_warning() {
+        let mut app = Pomo::new();
+        app.auto_switch_sessions = false;
+        app.is_running = true;
+        app.time_remaining = Duration::from_secs(30);
+        for _ in 0..29 {
+            assert_eq!(app.tick(), None);
+        }
+        assert_eq!(app.tick(), Some(AlertEvent::Complete(SessionMode::Work)));
+        assert_eq!(app.tick(), None);
+    }
+
+    #[test]
+    fn automatic_mode_reports_the_completed_session_before_switching() {
+        let mut app = Pomo::new();
+        app.auto_switch_sessions = true;
+        app.is_running = true;
+        app.time_remaining = Duration::from_secs(1);
+        assert_eq!(app.tick(), Some(AlertEvent::Complete(SessionMode::Work)));
+        assert_eq!(app.mode, SessionMode::ShortBreak);
+        assert!(app.is_running);
+    }
+}
