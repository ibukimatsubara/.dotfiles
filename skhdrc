#!/usr/bin/env sh

# ========================================
# skhd設定 - ワークスペース単位のアプリ切り替え
# ========================================
# Ghosttyは毎回新しいウィンドウを開く。
# ChromeとVS Codeは現在のワークスペースにあればフォーカスし、
# なければ新しいウィンドウを開く。
cmd - 1 : $HOME/.dotfiles/scripts/aerospace-focus-or-open.sh ghostty new-window
cmd - 2 : $HOME/.dotfiles/scripts/aerospace-focus-or-open.sh chrome
cmd - 3 : $HOME/.dotfiles/scripts/aerospace-focus-or-open.sh vscode
