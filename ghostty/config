# Ghostty Configuration
# Kitty設定から移行

# テーマ
theme = GitHub Dark

# テーマの文字色を上書き（より明るい白に）
foreground = #e6e6e6

# フォント設定
font-family = Hack Nerd Font Mono
font-size = 14

# 背景透過・ブラー（Hyprland風ガラス効果）
background-opacity = 0.78
background-opacity-cells = true
# 高負荷時に無効化。復元する場合は下の false と入れ替える。
# background-blur = 28
background-blur = false

# 背景画像は使わず、macOSの透過・ブラーだけを表示する

# ウィンドウ設定
window-decoration = auto
macos-titlebar-style = hidden
macos-window-shadow = true
# Keep global shortcuts available for Aqua Voice and AeroSpace. Secure Input
# can still be enabled manually from Ghostty when entering sensitive data.
macos-auto-secure-input = false
# Do not leave an empty app entry in Cmd+Tab after the last shell exits.
quit-after-last-window-closed = true
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true

# macOSでOptionキーをAltとして使用
macos-option-as-alt = true

# URL検出 (Cmd+クリックで開く)
link-url = true

# Shiftキーのマウス動作を変更（選択拡張を無効化）
mouse-shift-capture = always

# ドラッグで選択した文字を、Cmd+Vで貼り付けるクリップボードにもコピーする。
copy-on-select = clipboard

# スクロール設定 (Ghosttyはデフォルトで滑らかなスクロール)
# wheel_scroll_multiplier相当の設定はなし

# キーバインド - 全て無効化して必要なものだけ有効
keybind = clear
keybind = super+v=paste_from_clipboard
keybind = super+q=quit
keybind = super+w=close_window
# tmux専用キー（通常のCtrlキーとは衝突しないシーケンスを送る）
keybind = super+t=text:\x1b[5;30001~
keybind = super+r=text:\x1b[5;30003~
# 休憩タイマー(Hammerspoon)からのリロード用フォールバック
keybind = ctrl+alt+super+r=reload_config

# ターミナル設定
term = xterm-256color
# 新しいウィンドウは既存ウィンドウの作業ディレクトリを引き継がない。
working-directory = home
window-inherit-working-directory = false

# カーソル設定
cursor-style = block

# カスタムシェーダー (カーソルトレイル)
# custom-shader = ~/.dotfiles/ghostty/shaders/cursor_blaze.glsl
# 休憩タイマー(Hammerspoonが生成・更新する状態ファイル)
# custom-shader = ~/.cache/ghostty-break/break_state.glsl
# Animate custom shaders only while the terminal is focused. Keeping every
# Ghostty window animating across AeroSpace workspaces is unnecessarily costly.
# custom-shader-animation = true
custom-shader-animation = false
