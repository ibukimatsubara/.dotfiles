# Ubuntu / Linux configuration
theme = GitHub Dark
foreground = #e6e6e6
font-family = Hack Nerd Font Mono
font-size = 14
background-opacity = 0.78
background-opacity-cells = true
window-decoration = none
window-padding-x = 12
window-padding-y = 10
window-padding-balance = true
link-url = true
mouse-shift-capture = always
term = xterm-256color
cursor-style = block

# Keep normal Ctrl keys available to terminal applications.
keybind = clear
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+shift+q=quit
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+comma=reload_config
# tmux user-keys configured in tmux/tmux.conf.
keybind = ctrl+shift+t=text:\x1b[5;30001~
keybind = ctrl+shift+w=text:\x1b[5;30002~
keybind = ctrl+shift+r=text:\x1b[5;30003~

custom-shader = shaders/cursor_blaze.glsl
custom-shader-animation = always
